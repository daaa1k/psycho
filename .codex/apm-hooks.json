{
  "SessionStart": [
    {
      "matcher": "startup|resume|clear|compact",
      "hooks": [
        {
          "type": "command",
          "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.ps1\"",
          "command": "\".codex/hooks/pstack/hooks/session-start.sh\" codex"
        }
      ],
      "_apm_source": "michael-denyer/pstack-claude/plugins/pstack"
    }
  ]
}
